# ============================================================
# Postman 敏感信息保护 - 不提交到 Git
# ============================================================

# 包含敏感凭证的环境文件（appKey、appSecurity、token 等）
# 命名规范：将敏感环境文件命名为 *.secret.environment.yaml
postman/environments/*.secret.environment.yaml

# 本地覆盖文件（个人本地配置，不共享）
postman/environments/*.local.environment.yaml

# 全局变量（可能包含 accessToken、refreshToken 等运行时 token）
postman/globals/workspace.globals.yaml

# ============================================================
# Postman 本地缓存 / 临时文件
# ============================================================
.postman/cache/
.postman/*.log

# ============================================================
# 操作系统 / 编辑器临时文件
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ============================================================
# 本地密钥 / 凭证文件（通用）
# ============================================================
*.secret
*.secrets
.env
.env.local
.env.*.local
secrets.yaml
secrets.json
